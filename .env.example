# Example .env template
# Copy this file to .env and fill in your actual API keys

# ============================================
# BLOCKCHAIN (Required)
# ============================================
# Get these from Alchemy (https://alchemy.com)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE
POLYGON_WSS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE

# ============================================
# DATABASE (Required)
# ============================================
# For local development:
DATABASE_URL=postgresql://polymarket:password@localhost:5432/polymarket_insider

# For production, use Neon/RDS/Supabase:
# DATABASE_URL=postgresql://user:password@host:5432/polymarket_insider

# ============================================
# NOTIFICATIONS (Choose ONE)
# ============================================

# Discord Webhook (recommended)
WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# OR Telegram Bot (alternative)
# TELEGRAM_TOKEN=123456789:ABCDefGhIjklMnoPqrSTuvWxyz
# TELEGRAM_CHAT_ID=987654321

# ============================================
# ML SCORING (Optional Tuning)
# ============================================
# Threshold at which to alert (0-100)
# ANOMALY_THRESHOLD=80.0