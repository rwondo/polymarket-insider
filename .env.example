# Copy to .env and fill in what you need. Everything is optional.

# Database: SQLite file by default. For Postgres (e.g. via docker-compose):
# DATABASE_URL=postgresql://polymarket:polymarket@localhost:5432/polymarket_insider
DATABASE_URL=sqlite:///polymarket_insider.db

# Discord webhook for flagged trades
WEBHOOK_URL=
# Discord webhook for every trade (very noisy, see README)
ALL_TRADES_WEBHOOK_URL=

# Scoring and retraining
ANOMALY_THRESHOLD=60
LARGE_TRADE_USD=10000
MIN_TRAINING_TRADES=1000
RETRAIN_INTERVAL_SECONDS=3600
POLL_INTERVAL_SECONDS=60
MIN_TRADE_USD=500
BACKFILL_TRADES=5000

# Password for the Postgres container in docker-compose.yml
DB_PASSWORD=change-me
